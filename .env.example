SARVAM_API_KEY=
BODHAN_API_KEY=
OPENROUTER_API_KEY=
OCR_LANGUAGE=en-IN
QWEN_MODEL=qwen/qwen3.8-flash
BODHAN_MODEL=indic-ocr
# html keeps merged cells (rowspan/colspan); markdown flattens them
BODHAN_TABLE_FORMAT=html
QWEN_WORKERS=3
BODHAN_WORKERS=4
# Bodhan: 8 requests per ~60 s per model (measured 2026-10-10)
BODHAN_RATE_PER_MIN=8
BODHAN_MAX_INFLIGHT=4
# api calls https://api.bodhan.ai. local runs the open weights.
BODHAN_BACKEND=api
# mlx on Apple Silicon (BF16 Metal recognizer). pytorch on the RTX 5070 (CUDA kernels).
# vllm on the RTX 5070: start ./serve-bodhan-vllm.sh first (~42 pages/min vs ~3 for pytorch).
# Lead engine (reads every page, supplies the document; the other reads table pages): sarvam | bodhan | auto.
# auto = bodhan with BODHAN_RUNTIME=vllm (free, faster than Sarvam), sarvam otherwise. Also --lead on the run.
# BODHAN_LEAD=auto
# BODHAN_RUNTIME=mlx
# BODHAN_LOCAL_DIR=models/indic-ocr
# BODHAN_DEVICE=mps
# Sarvam Vision: 10 requests/min per account (status polls count)
SARVAM_RATE_PER_MIN=10
PDF_LONG_EDGE=1600
RENDER_DPI=200
RENDER_MAX_LONG_PX=3000
# Agent and vision tie-breaker (OpenRouter now; http://localhost:8080/v1 on the RTX 5070)
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=qwen/qwen3.5-9b
VERIFIER_VLM_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BUDGET_USD=2
# Cost accounting in rupees
SARVAM_INR_PER_PAGE=0.5
BODHAN_INR_PER_PAGE=0.2
INR_PER_USD=85
